# Copy to .env for local development (never commit real secrets).
# ap-south-1 (Mumbai) is the default region. Nova there needs an inference
# profile id (apac.* prefix). For us-east-1 use BEDROCK_MODEL_ID=amazon.nova-lite-v1:0.
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
BEDROCK_REGION=ap-south-1
BEDROCK_ENABLED=true

# NSE MCP: left disabled by default because the official endpoints are behind
# Akamai bot protection and return 504 to headless clients. Point these at a
# browser-session proxy and set NSE_MCP_ENABLED=true to use live data.
NSE_MCP_ENABLED=false
NSE_MCP_CM_URL=https://mcp.nseindia.in/cmmkt/mcp
NSE_MCP_BHAV_URL=https://mcp.nseindia.in/bhavcopy/cm/mcp

# Local persistence: in-memory unless you point at a real table.
DYNAMODB_ENABLED=false
TABLE_NAME=investmate

CORS_ALLOW_ORIGIN=*
