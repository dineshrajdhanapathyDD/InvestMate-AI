<mxfile host="app.diagrams.net" agent="InvestMate AI" version="24.0.0">
  <diagram id="investmate-arch" name="InvestMate AI Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="InvestMate AI - AWS Architecture (ap-south-1)" style="text;html=1;align=center;fontSize=20;fontStyle=1;fontColor=#0f1424;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="React SPA to API Gateway to Lambda agent to Amazon Bedrock, with a graceful NSE MCP fallback" style="text;html=1;align=center;fontSize=12;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="250" y="48" width="600" height="20" as="geometry" />
        </mxCell>

        <!-- User -->
        <mxCell id="user" value="Retail investor&#10;(browser)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#4f8cff;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="40" height="80" as="geometry" />
        </mxCell>

        <!-- Frontend group -->
        <mxCell id="feGroup" value="Frontend hosting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f7ff;strokeColor=#4f8cff;dashed=1;verticalAlign=top;fontColor=#1e2740;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="110" width="240" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cloudfront" value="Amazon CloudFront&#10;(HTTPS, SPA fallback)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8c4fff;fontColor=#1e2740;" vertex="1" parent="1">
          <mxGeometry x="170" y="150" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s3web" value="Amazon S3&#10;(private bucket, OAC)&#10;React + TS + Vite build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1fae63;fontColor=#1e2740;" vertex="1" parent="1">
          <mxGeometry x="170" y="230" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- API Gateway -->
        <mxCell id="apigw" value="Amazon API Gateway&#10;REST /api/v1/*&#10;(validation + throttling 10 rps)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2e6;strokeColor=#e07b00;fontColor=#1e2740;" vertex="1" parent="1">
          <mxGeometry x="440" y="150" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Lambda group -->
        <mxCell id="lambdaGroup" value="AWS Lambda (Python 3.13) - agent orchestrator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#e07b00;dashed=1;verticalAlign=top;fontColor=#1e2740;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="270" width="260" height="300" as="geometry" />
        </mxCell>
        <mxCell id="router" value="Router + request validation&#10;(consistent JSON envelope)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e07b00;fontColor=#1e2740;" vertex="1" parent="1">
          <mxGeometry x="440" y="300" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="ResearchAgent&#10;Bedrock Converse tool-use loop&#10;(model selects tool, backend runs it)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e07b00;fontColor=#1e2740;" vertex="1" parent="1">
          <mxGeometry x="440" y="365" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="provider" value="ResilientProvider&#10;live NSE MCP first, labelled&#10;sample-data fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e07b00;fontColor=#1e2740;" vertex="1" parent="1">
          <mxGeometry x="440" y="440" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="sample" value="SampleDataProvider&#10;(deterministic, is_sample=true)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;fontColor=#1e2740;" vertex="1" parent="1">
          <mxGeometry x="440" y="505" width="220" height="45" as="geometry" />
        </mxCell>

        <!-- Bedrock -->
        <mxCell id="bedrock" value="Amazon Bedrock&#10;Nova Lite&#10;apac.amazon.nova-lite-v1:0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#6d28d9;fontColor=#1e2740;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="365" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- DynamoDB -->
        <mxCell id="dynamo" value="Amazon DynamoDB&#10;watchlist + preferences&#10;(pk=CLIENT#id)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e2740;" vertex="1" parent="1">
          <mxGeometry x="760" y="150" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- NSE MCP (blocked) -->
        <mxCell id="nse" value="NSE MCP endpoints&#10;cm-market / nse-bhavcopy&#10;(streamable-http)&#10;BLOCKED by Akamai: 504 to headless" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="470" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- CloudWatch -->
        <mxCell id="cw" value="Amazon CloudWatch&#10;logs + metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#1e2740;" vertex="1" parent="1">
          <mxGeometry x="760" y="270" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4f8cff;" edge="1" parent="1" source="user" target="cloudfront">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="serves app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#1fae63;fontSize=10;" edge="1" parent="1" source="cloudfront" target="s3web">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="HTTPS /api/v1 (CORS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#e07b00;fontSize=10;" edge="1" parent="1" source="cloudfront" target="apigw">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="410" y="175" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="Lambda proxy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#e07b00;fontSize=10;" edge="1" parent="1" source="apigw" target="router">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#e07b00;" edge="1" parent="1" source="router" target="agent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="tool_use" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;startArrow=block;strokeColor=#6d28d9;fontSize=10;" edge="1" parent="1" source="agent" target="bedrock">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="executes tool" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#e07b00;fontSize=10;" edge="1" parent="1" source="agent" target="provider">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="fallback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b45309;fontSize=10;" edge="1" parent="1" source="provider" target="sample">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="try live (504)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#dc2626;dashed=1;fontSize=10;" edge="1" parent="1" source="provider" target="nse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="watchlist / prefs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;startArrow=block;strokeColor=#2563eb;fontSize=10;" edge="1" parent="1" source="router" target="dynamo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="logs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748b;fontSize=10;" edge="1" parent="1" source="agent" target="cw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Legend: solid = working path.  dashed red = verified-unreachable live NSE path (Akamai), app falls back to labelled sample data." style="text;html=1;align=left;fontSize=10;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="140" y="600" width="800" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
